{
  "name": "movex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @movex/web",
    "dev:api": "npm run dev -w @movex/api",
    "dev:app": "npm run start -w @movex/rider-app",
    "build:web": "npm run build -w @movex/web",
    "start:api": "npm run start -w @movex/api",
    "lint": "npm run lint -w @movex/web && npm run lint -w @movex/rider-app"
  }
}
